{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paper-stage-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "durable_objects": {
    "bindings": [
      {
        "name": "STAGES",
        "class_name": "Stage",
      },
    ],
  },
  "exports": {
    "Stage": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "observability": {
    "enabled": true,
    // Asset URLs carry the stage token in their query string.
    "redact_query_string": true,
    "traces": {
      "enabled": true,
    },
  },
}
